{
  "expo": {
    "name": "SmartLab",
    "slug": "smartlab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartlab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.smartlab.app",
      "adaptiveIcon": {
        "backgroundColor": "#EDEFF5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SmartLab necesita la cámara para fotografiar y leer códigos QR.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SmartLab usa tu ubicación solo cuando consultás el GPS."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "SmartLab lee el movimiento mientras usás la pantalla de sensores."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SmartLab delega la verificación de identidad al sistema operativo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EDEFF5",
          "dark": {
            "backgroundColor": "#10131D"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "706efc44-552a-4b40-9e0e-a05d3111c1dc"
      }
    }
  }
}
